<div class="max-w-5xl mx-auto">
  <%= link_to "← 商品一覧に戻る", products_path, class: "text-sm text-gray-500 hover:text-gray-700 mb-4 inline-block" %>
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">商品を編集</h1>
    <%= link_to edit_product_food_label_path(@product), class: "inline-flex items-center gap-1 text-sm text-orange-500 hover:text-orange-700 font-medium" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z" />
      </svg>
      食品表示ラベル
    <% end %>
  </div>

  <%= form_with(model: @product, class: "space-y-6", data: { controller: "cost-calculator allergen-display nutrition-calculator" }) do |f| %>
    <%= render "editor_shell", f: f, product: @product, materials: @materials %>
  <% end %>
</div>
